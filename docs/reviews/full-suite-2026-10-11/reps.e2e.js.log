  ok  #6 — הקלדה אינה נמחקת תוך כדי — השדה שבמיקוד לא נדרס
  ok  #7 — Enter עובר לתלמיד הבא
  ok  #8 — מחיקת המספר מסירה את המדידה ולא שומרת אפס
  ok  #9 — מיקוד בוחר את הקיים, כדי שהקלדה תחליף ולא תיצמד
  ok  #10 — השדה מציג את מה שנשמר כשחוזרים למסך
  ok  #11 — יש קפיצה של 5 לשני הכיוונים, לצד ההקשה הבודדת
  ok  #12 — שתים־עשרה הקשות על +5 מגיעות ל-60
  ok  #13 — −5 יורד בחמש, ולא מתחת לאפס
  ok  #14 — +5 ממשיך ממה שהוקלד, ולא מאפס
  ok  #15 — השדה נראה כמו שדה — אחרת ממשיכים להקיש «+»

